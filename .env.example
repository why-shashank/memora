# Copy to .env and adjust. All settings use the MEMORA_ prefix.
# MEMORA_DATABASE_URL=postgresql+asyncpg://memora:memora@localhost:5432/memora

# LLM — bring your own key (.env is gitignored; never commit keys)
# MEMORA_ANTHROPIC_API_KEY=sk-ant-...
# MEMORA_LLM_MODEL=claude-haiku-4-5-20251001

# Embeddings — local by default (no key, no egress); needs the "local" extra installed.
# Picking a different model is a setup-time decision: changing it later requires a
# schema migration + re-embedding all stored memories.
# MEMORA_EMBEDDING_MODEL=all-MiniLM-L6-v2
